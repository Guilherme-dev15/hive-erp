generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  SELLER
}

enum ProductStatus {
  ATIVO
  INATIVO
}

enum CouponStatus {
  ATIVO
  INATIVO
}

enum PaymentMethod {
  PIX
  CREDIT_CARD
  BOLETO
  MANUAL
}

enum OrderStatus {
  AGUARDANDO_PAGAMENTO
  PAGO
  EM_PRODUCAO
  EM_SEPARACAO
  ENVIADO
  CONCLUIDO
  CANCELADO
}

enum TransactionType {
  VENDA
  DESPESA
  CAPITAL
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  EXPIRED
  CANCELED
}

enum SetupBatchTier {
  UP_TO_200
  UP_TO_300
  UP_TO_500
}

enum SetupRequestStatus {
  PENDING
  PAID
  IN_PROGRESS
  COMPLETED
  CANCELED
}

enum BillingActionType {
  TRIAL_STARTED
  CHECKOUT_INTENT_CREATED
  SUBSCRIPTION_ACTIVATED
  SUBSCRIPTION_EXTENDED
  SUBSCRIPTION_EXPIRED
  SUBSCRIPTION_CANCELED
  SETUP_REQUEST_CREATED
  SETUP_REQUEST_STATUS_CHANGED
  ACCOUNT_SUSPENDED
  ACCOUNT_REACTIVATED
}

model User {
  id        String   @id @default(uuid()) @db.Uuid
  email     String   @unique
  name      String
  role      Role     @default(OWNER)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relacionamentos - Base do Tenancy
  config               Config?
  categories           Category[]
  suppliers            Supplier[]
  products             Product[]
  coupons              Coupon[]
  orders               Order[]
  transactions         Transaction[]
  inventoryLogs        InventoryLog[]
  dashboardStats       DashboardStat?
  subscription         Subscription?
  productSetupRequests ProductSetupRequest[]
  billingEvents        BillingEvent[]

  // Campo transiente para a migração do Firebase
  legacyId String? @unique @map("legacy_id")

  @@map("users")
}

model Config {
  id     String @id @default(uuid()) @db.Uuid
  userId String @unique @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  storeName         String   @map("store_name")
  publicSlug        String?  @unique @map("public_slug")
  primaryColor      String   @default("#D4AF37") @map("primary_color")
  secondaryColor    String   @default("#343434") @map("secondary_color")
  whatsappNumber    String?  @map("whatsapp_number")
  monthlyGoal       Decimal? @map("monthly_goal") @db.Decimal(10, 2)
  banners           Json?
  cardFee           Decimal  @default(0) @map("card_fee") @db.Decimal(5, 2)
  packagingCost     Decimal  @default(0) @map("packaging_cost") @db.Decimal(10, 2)
  lowStockThreshold Int      @default(5) @map("low_stock_threshold")
  warrantyText      String?  @map("warranty_text") @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("configs")
}

model Category {
  id       String    @id @default(uuid()) @db.Uuid
  userId   String    @map("user_id") @db.Uuid
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name     String
  products Product[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Campo transiente para a migração do Firebase
  legacyId String? @unique @map("legacy_id")

  @@map("categories")
}

model Supplier {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  contactPhone String?   @map("contact_phone")
  email        String?
  pixKey       String?   @map("pix_key")
  url          String?
  paymentTerms String?   @map("payment_terms") @db.Text
  rules        Json?
  products     Product[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Campo transiente para a migração do Firebase
  legacyId String? @unique @map("legacy_id")

  @@map("suppliers")
}

model Product {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name        String
  code        String?
  categoryId  String?   @map("category_id") @db.Uuid
  category    Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  subcategory String?
  description String?   @db.Text
  imageUrl    String?   @map("image_url") @db.Text

  costPrice     Decimal  @default(0) @map("cost_price") @db.Decimal(10, 2)
  salePrice     Decimal  @default(0) @map("sale_price") @db.Decimal(10, 2)
  marginPercent Decimal? @map("margin_percent") @db.Decimal(5, 2)

  quantity Int           @default(0)
  weight   Decimal?      @db.Decimal(10, 3)
  status   ProductStatus @default(ATIVO)

  supplierId         String?   @map("supplier_id") @db.Uuid
  supplier           Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  supplierProductUrl String?   @map("supplier_product_url") @db.Text

  variants      ProductVariant[]
  orderItems    OrderItem[]
  transactions  Transaction[]
  inventoryLogs InventoryLog[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Campo transiente para a migração do Firebase
  legacyId String? @unique @map("legacy_id")

  @@map("products")
}

model ProductVariant {
  id              String  @id @default(uuid()) @db.Uuid
  productId       String  @map("product_id") @db.Uuid
  product         Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  skuSuffix       String  @map("sku_suffix")
  adjustmentValue Decimal @default(0) @map("adjustment_value") @db.Decimal(10, 2)
  measurement     String?
  stock           Int     @default(0)
  onDemand        Boolean @default(false) @map("on_demand")

  createdAt DateTime @default(now()) @map("created_at")

  // Campo transiente para a migração do Firebase
  legacyId String? @unique @map("legacy_id")

  @@map("product_variants")
}

model Coupon {
  id              String       @id @default(uuid()) @db.Uuid
  userId          String       @map("user_id") @db.Uuid
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  code            String
  discountPercent Decimal      @map("discount_percent") @db.Decimal(5, 2)
  status          CouponStatus @default(ATIVO)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Campo transiente para a migração do Firebase
  legacyId String? @unique @map("legacy_id")

  @@map("coupons")
}

model Order {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  customerName  String      @map("customer_name")
  customerPhone String?     @map("customer_phone")
  status        OrderStatus @default(AGUARDANDO_PAGAMENTO)

  subtotal            Decimal @default(0) @db.Decimal(10, 2)
  discount            Decimal @default(0) @db.Decimal(10, 2)
  total               Decimal @default(0) @db.Decimal(10, 2)
  notes               String? @db.Text
  financialRegistered Boolean @default(false) @map("financial_registered")

  // Gateway de Pagamentos V2
  paymentMethod     PaymentMethod? @map("payment_method")
  gatewayOrderId    String?        @map("gateway_order_id")
  gatewayPaymentUrl String?        @map("gateway_payment_url")
  gatewayStatus     String?        @map("gateway_status")

  items        OrderItem[]
  transactions Transaction[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Campo transiente para a migração do Firebase
  legacyId String? @unique @map("legacy_id")

  @@map("orders")
}

model OrderItem {
  id      String @id @default(uuid()) @db.Uuid
  orderId String @map("order_id") @db.Uuid
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId String?  @map("product_id") @db.Uuid
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  name      String
  code      String?
  salePrice Decimal @map("sale_price") @db.Decimal(10, 2)
  quantity  Int
  imageUrl  String? @map("image_url") @db.Text

  @@map("order_items")
}

model Transaction {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type        TransactionType
  date        DateTime
  amount      Decimal         @db.Decimal(10, 2)
  description String          @db.Text
  category    String?

  // Referência do Gateway caso seja uma venda capturada
  gatewayTransactionId String? @map("gateway_transaction_id")

  productId String?  @map("product_id") @db.Uuid
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  orderId   String?  @map("order_id") @db.Uuid
  order     Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Campo transiente para a migração do Firebase
  legacyId String? @unique @map("legacy_id")

  @@map("transactions")
}

model PaymentWebhookEvent {
  id                   String    @id @default(uuid()) @db.Uuid
  provider             String
  eventId              String    @map("event_id")
  eventType            String    @map("event_type")
  gatewayOrderId       String?   @map("gateway_order_id")
  gatewayTransactionId String?   @map("gateway_transaction_id")
  amount               Decimal?  @db.Decimal(10, 2)
  payload              Json?
  processedAt          DateTime? @map("processed_at")
  createdAt            DateTime  @default(now()) @map("created_at")

  @@unique([provider, eventId])
  @@index([gatewayOrderId])
  @@map("payment_webhook_events")
}

model InventoryLog {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  productId String  @map("product_id") @db.Uuid
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  type        String
  change      Int
  newQuantity Int     @map("new_quantity")
  userName    String? @map("user_name")

  createdAt DateTime @default(now()) @map("created_at")

  @@map("inventory_logs")
}

model DashboardStat {
  id     String @id @default(uuid()) @db.Uuid
  userId String @unique @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  revenue     Decimal? @default(0) @db.Decimal(15, 2)
  totalOrders Int?     @default(0) @map("total_orders")

  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("dashboard_stats")
}

model Subscription {
  id                 String             @id @default(uuid()) @db.Uuid
  userId             String             @unique @map("user_id") @db.Uuid
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  status             SubscriptionStatus @default(TRIAL)
  planCode           String             @default("PRO_MONTHLY") @map("plan_code")
  monthlyPriceCents  Int                @default(9700) @map("monthly_price_cents")
  trialStartsAt      DateTime           @default(now()) @map("trial_starts_at")
  trialEndsAt        DateTime           @map("trial_ends_at")
  currentPeriodStart DateTime?          @map("current_period_start")
  currentPeriodEnd   DateTime?          @map("current_period_end")
  activatedAt        DateTime?          @map("activated_at")
  canceledAt         DateTime?          @map("canceled_at")
  isExempt           Boolean            @default(false) @map("is_exempt")
  lastPaymentNote    String?            @map("last_payment_note") @db.Text
  updatedByAdminId   String?            @map("updated_by_admin_id") @db.Uuid
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  @@index([status])
  @@index([trialEndsAt])
  @@index([currentPeriodEnd])
  @@map("subscriptions")
}

model ProductSetupRequest {
  id                    String             @id @default(uuid()) @db.Uuid
  userId                String             @map("user_id") @db.Uuid
  user                  User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  batchTier             SetupBatchTier     @map("batch_tier")
  maxProducts           Int                @map("max_products")
  priceCents            Int                @map("price_cents")
  includeMonthlyPlan    Boolean            @default(false) @map("include_monthly_plan")
  monthlyPlanPriceCents Int                @default(0) @map("monthly_plan_price_cents")
  totalPriceCents       Int                @map("total_price_cents")
  status                SetupRequestStatus @default(PENDING)
  referenceCode         String             @unique @map("reference_code")
  contactPhone          String?            @map("contact_phone")
  sourceDescription     String?            @map("source_description") @db.Text
  whatsappMessage       String?            @map("whatsapp_message") @db.Text
  adminNotes            String?            @map("admin_notes") @db.Text
  importedCount         Int?               @map("imported_count")
  paidAt                DateTime?          @map("paid_at")
  startedAt             DateTime?          @map("started_at")
  completedAt           DateTime?          @map("completed_at")
  canceledAt            DateTime?          @map("canceled_at")
  updatedByAdminId      String?            @map("updated_by_admin_id") @db.Uuid
  createdAt             DateTime           @default(now()) @map("created_at")
  updatedAt             DateTime           @updatedAt @map("updated_at")

  @@index([userId, createdAt(sort: Desc)])
  @@index([status])
  @@map("product_setup_requests")
}

model BillingEvent {
  id            String            @id @default(uuid()) @db.Uuid
  userId        String            @map("user_id") @db.Uuid
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  action        BillingActionType
  actorUserId   String?           @map("actor_user_id") @db.Uuid
  amountCents   Int?              @map("amount_cents")
  daysGranted   Int?              @map("days_granted")
  referenceCode String?           @map("reference_code")
  note          String?           @db.Text
  metadata      Json?
  createdAt     DateTime          @default(now()) @map("created_at")

  @@index([userId, createdAt(sort: Desc)])
  @@index([action])
  @@map("billing_events")
}

