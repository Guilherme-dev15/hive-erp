# ============================================================================
# HivePratas ERP — Variáveis de Ambiente (EXEMPLO)
# ============================================================================
# Copie este arquivo para `.env` na raiz do projeto e preencha com seus
# valores reais. NUNCA commite o arquivo `.env` no Git — ele já está
# protegido pelo `.gitignore`.
#
# Documentação de cada variável:
# - STRIPE_*: Credenciais do Stripe (desativado no MVP, mantido para futuro).
# - FIREBASE_*: Configuração do Firebase/Firestore.
# - JWT_*: Segredo para assinatura de tokens de autenticação.
# - CORS_ORIGIN: Origem permitida para requisições CORS em produção.
# ============================================================================

# ─── Aplicação ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:5173

# ─── Firebase / Firestore ───────────────────────────────────────────────────
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
GOOGLE_APPLICATION_CREDENTIALS=

# ─── Autenticação ───────────────────────────────────────────────────────────
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ─── Stripe (Desativado no MVP, placeholder para futuro) ─────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLIC_KEY=

# ─── Scripts de Migração (apenas se necessário) ──────────────────────────────
# UID de admin para vincular dados durante migrações. Receber via CLI/env.
MIGRATION_ADMIN_UID=