rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Imagens organizadas por UID do lojista autenticado
    match /products/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /produtos/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Compatibilidade temporária apenas para leitura de URLs legadas sem prefixo de UID
    match /products/{fileName} {
      allow read: if true;
      allow write: if false;
    }

    match /produtos/{fileName} {
      allow read: if true;
      allow write: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
