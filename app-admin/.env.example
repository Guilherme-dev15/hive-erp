# Variáveis de Ambiente para o Frontend (app-admin)
# Copie este arquivo para .env na raiz de /app-admin e preencha com os valores do seu projeto Firebase.
# Essas variáveis são expostas ao cliente e devem começar com VITE_.

VITE_FIREBASE_API_KEY="AIzaSy... (Sua Chave de API Web do Firebase)"
VITE_FIREBASE_AUTH_DOMAIN="seu-projeto.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="seu-projeto-id"
VITE_FIREBASE_STORAGE_BUCKET="seu-projeto.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="1234567890"
VITE_FIREBASE_APP_ID="1:1234567890:web:abcdef123456"
VITE_FIREBASE_MEASUREMENT_ID="G-ABCDEFGHIJ"

# URL da origem da API Backend. Os endpoints já incluem /api/v2.
# Não inclua o sufixo /api aqui, para evitar /api/api/v2.
VITE_API_URL="https://hive-erp.vercel.app"
